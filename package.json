{
  "name": "kairopro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test && vitest run",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @kairopro/db db:generate",
    "db:migrate": "pnpm --filter @kairopro/db db:migrate",
    "db:seed": "pnpm --filter @kairopro/db db:seed",
    "db:studio": "pnpm --filter @kairopro/db db:studio",
    "db:up": "docker compose --env-file .env -f docker/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f docker/docker-compose.yml down",
    "design:lint": "npx -p @google/design.md designmd lint DESIGN.md",
    "design:export": "npx -p @google/design.md designmd export --format css-tailwind DESIGN.md > apps/web/src/app/theme.css"
  },
  "devDependencies": {
    "@kairopro/core": "workspace:*",
    "@kairopro/db": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pg": "^8.16.3",
    "prettier": "^3.4.2",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
