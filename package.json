{
  "name": "kairopro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @kairopro/db db:generate",
    "db:migrate": "pnpm --filter @kairopro/db db:migrate",
    "db:seed": "pnpm --filter @kairopro/db db:seed",
    "db:studio": "pnpm --filter @kairopro/db db:studio",
    "design:lint": "npx -p @google/design.md designmd lint DESIGN.md",
    "design:export": "npx -p @google/design.md designmd export --format css-tailwind DESIGN.md > apps/web/src/app/theme.css"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
