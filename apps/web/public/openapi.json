{
  "openapi": "3.1.0",
  "info": {
    "title": "KairoPro API",
    "version": "1.0.0",
    "description": "The full KairoPro backend API — every route under apps/web/src/app/api. Session auth is a NextAuth cookie (`next-auth.session-token`); log in through the app in the same browser tab first, then 'Try it' requests here will carry that cookie automatically since this page is served from the same origin."
  },
  "servers": [{ "url": "/", "description": "This app" }],
  "tags": [
    {
      "name": "Auth",
      "description": "Registration and NextAuth-managed sign-in"
    },
    { "name": "Projects", "description": "Project CRUD" },
    {
      "name": "Inputs",
      "description": "Requirements text and file attachments"
    },
    {
      "name": "Specs",
      "description": "PRD / Design / Data Model / App Structure generation and approval"
    },
    {
      "name": "Builds",
      "description": "Build orchestration and live log streaming"
    },
    {
      "name": "Changes",
      "description": "Post-build change requests (plan → approve → apply)"
    },
    {
      "name": "Credentials",
      "description": "Per-project third-party service credentials"
    },
    { "name": "Deploy", "description": "Production deploy to a subdomain" },
    {
      "name": "GitHub Export",
      "description": "Export a project's workspace to a GitHub repo"
    },
    {
      "name": "Versions",
      "description": "Git-backed version history, diff, and revert"
    },
    { "name": "Webhooks", "description": "Inbound webhooks from third parties" }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "next-auth.session-token",
        "description": "Set by signing in through the app's own /login page in this browser."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHORIZED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "PROVIDER_ERROR",
                  "TIMEOUT_ERROR",
                  "RATE_LIMITED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": { "type": "string" }
            }
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "orgId": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "SPECIFYING", "BUILDING", "READY", "DEPLOYED"]
          },
          "templateId": { "type": "string" },
          "previewUrl": { "type": "string", "nullable": true },
          "deployedUrl": { "type": "string", "nullable": true },
          "subdomain": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ProjectListItem": {
        "allOf": [
          { "$ref": "#/components/schemas/Project" },
          {
            "type": "object",
            "properties": {
              "stack": { "type": "string", "nullable": true },
              "latestCommitHash": { "type": "string", "nullable": true },
              "lastActivityAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "CreateProjectInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": { "type": "string", "maxLength": 2000 }
        }
      },
      "UpdateProjectInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "RegisterInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 }
        }
      },
      "Input": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "kind": { "type": "string", "enum": ["TEXT", "FILE"] },
          "originalName": { "type": "string", "nullable": true },
          "mimeType": { "type": "string", "nullable": true },
          "sizeBytes": { "type": "integer" },
          "extraction": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "SaveTextInput": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 50000 }
        }
      },
      "Spec": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["PRD", "DESIGN", "DATA_MODEL", "APP_STRUCTURE"]
          },
          "version": { "type": "integer" },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_APPROVAL",
              "APPROVED",
              "REJECTED",
              "STALE"
            ]
          },
          "content": {
            "description": "Opaque, shape depends on `type` — see docs/BACKEND_AI_PLAN.md Phase 11.",
            "type": "object"
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "RequestSpecChangeInput": {
        "type": "object",
        "required": ["instruction"],
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 3,
            "maxLength": 2000,
            "example": "Add subtasks to tasks"
          }
        }
      },
      "SpecChangeResult": {
        "type": "object",
        "required": ["summary", "specs"],
        "properties": {
          "summary": {
            "type": "string",
            "description": "What changed, in plain language."
          },
          "specs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Spec" },
            "description": "New spec versions written (PRD, DATA_MODEL, APP_STRUCTURE). Empty when the request changed nothing."
          }
        }
      },
      "ReviseSpecInput": {
        "type": "object",
        "required": ["content"],
        "description": "The FULL replacement content for this spec type — not a free-text change request.",
        "properties": { "content": { "type": "object" } }
      },
      "Build": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "commitHash": { "type": "string", "nullable": true },
          "previewUrl": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ChangeRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "PLANNING",
              "AWAITING_APPROVAL",
              "APPLYING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "request": { "type": "string" },
          "plan": {
            "type": "object",
            "nullable": true,
            "properties": {
              "summary": { "type": "string" },
              "diffSummary": { "type": "string" },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "task": { "type": "string" }
                  }
                }
              }
            }
          },
          "commitHash": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RequestChangeInput": {
        "type": "object",
        "required": ["request"],
        "properties": {
          "request": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      },
      "CredentialField": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "maskedValue": { "type": "string" }
        }
      },
      "ServiceCredentials": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": ["google_oauth", "stripe", "sendgrid", "aws_s3"]
          },
          "status": {
            "type": "string",
            "enum": ["CONNECTED", "UNCONFIGURED", "UNUSED"]
          },
          "fields": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CredentialField" }
          }
        }
      },
      "PutCredentialInput": {
        "type": "object",
        "required": ["values"],
        "properties": {
          "values": {
            "type": "object",
            "description": "fieldKey -> raw secret value, e.g. { \"secretKey\": \"sk_live_...\" } for stripe",
            "additionalProperties": { "type": "string" }
          }
        }
      },
      "DeployInput": {
        "type": "object",
        "properties": {
          "subdomain": {
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "pattern": "^[a-z0-9-]+$",
            "description": "Required on first deploy; ignored (reused) on redeploy."
          }
        }
      },
      "DeployResult": {
        "type": "object",
        "properties": {
          "projectId": { "type": "string" },
          "subdomain": { "type": "string" },
          "deployedUrl": { "type": "string", "format": "uri" }
        }
      },
      "GithubConnectInput": {
        "type": "object",
        "required": ["accessToken", "githubLogin"],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "A GitHub personal access token (no OAuth App flow yet — see docs/FRONTEND_INTEGRATION_PLAN.md gap G3)."
          },
          "githubLogin": { "type": "string" }
        }
      },
      "GithubConnectionStatus": {
        "type": "object",
        "properties": {
          "connected": { "type": "boolean" },
          "githubLogin": { "type": "string", "nullable": true },
          "repoUrl": { "type": "string", "nullable": true }
        }
      },
      "GithubExportResult": {
        "type": "object",
        "properties": {
          "repoUrl": { "type": "string", "format": "uri" },
          "defaultBranch": { "type": "string" }
        }
      },
      "Version": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "hash": { "type": "string" },
          "message": { "type": "string" },
          "filesChanged": { "type": "integer" },
          "revertible": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "VersionDiff": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "filesChanged": { "type": "integer" },
              "insertions": { "type": "integer" },
              "deletions": { "type": "integer" }
            }
          },
          "raw": { "type": "string", "description": "Unified diff text" }
        }
      }
    }
  },
  "security": [{ "sessionCookie": [] }],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created — signed in on the frontend right after this"
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "tags": ["Auth"],
        "summary": "Step 1 of login: get a CSRF token",
        "security": [],
        "description": "Also sets a `next-auth.csrf-token` cookie that must accompany the token below in the next request — 'Try it' keeps cookies automatically within this page.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "csrfToken": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/callback/credentials": {
      "post": {
        "tags": ["Auth"],
        "summary": "Step 2 of login: sign in with email + password",
        "security": [],
        "description": "Form-encoded, not JSON. `csrfToken` must be the value GET /api/auth/csrf just returned. On success this sets the session cookie — after this, every other request in this page is authenticated. Set `json` to `true` to get a JSON response back instead of a redirect.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "csrfToken"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" },
                  "csrfToken": { "type": "string" },
                  "json": { "type": "boolean", "default": true },
                  "callbackUrl": { "type": "string", "default": "/dashboard" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session cookie set (wrong credentials also come back 200, with a `url` pointing at /login?error=CredentialsSignin — no session cookie in that case)"
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": ["Auth"],
        "summary": "Check who (if anyone) is currently signed in",
        "security": [],
        "responses": {
          "200": {
            "description": "`{}` when signed out; `{user:{...}, expires}` when signed in",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/api/auth/signout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Sign out (clears the session cookie)",
        "security": [],
        "description": "Also needs a fresh csrfToken, same as signing in.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["csrfToken"],
                "properties": {
                  "csrfToken": { "type": "string" },
                  "json": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Signed out" } }
      }
    },
    "/api/projects": {
      "get": {
        "tags": ["Projects"],
        "summary": "List the caller's org's projects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ProjectListItem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Projects"],
        "summary": "Create a project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProjectInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Projects"],
        "summary": "Get one project",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Projects"],
        "summary": "Update a project's name/description",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProjectInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Project" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Projects"],
        "summary": "Delete a project",
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/api/projects/{id}/inputs": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Inputs"],
        "summary": "List a project's requirement inputs",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Input" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Inputs"],
        "summary": "Save requirements text OR upload file attachment(s)",
        "description": "Send EITHER application/json ({text}) to upsert the project's single text input, OR multipart/form-data with a `files` field to upload an attachment. To upload more than one file at once, switch content type to multipart/form-data, click 'Add item' next to files if shown, or just repeat this request once per file — each call adds one more attachment.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveTextInput" }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["files"],
                "properties": {
                  "files": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/api/projects/{id}/inputs/{inputId}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "inputId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "delete": {
        "tags": ["Inputs"],
        "summary": "Delete one attachment",
        "responses": { "204": { "description": "Deleted" } }
      }
    },
    "/api/projects/{id}/specs": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "tags": ["Specs"],
        "summary": "List the project's latest spec of each type",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Spec" }
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}/specs/generate": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Specs"],
        "summary": "Kick off spec generation (pm-questions -> PRD -> design -> data model -> app structure)",
        "description": "Returns 202 immediately; generation runs in the background. Poll GET /specs to watch each spec type land.",
        "responses": {
          "202": { "description": "Accepted" },
          "404": {
            "description": "Project not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}/specs/change": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Specs"],
        "summary": "Apply a natural-language change to the PRD and regenerate the data model and app structure",
        "description": "Synchronous: takes up to about a minute (three sequential LLM calls) and returns once the new versions are written. The design spec is not touched. If the request is not a change to the requirements, nothing is written and `specs` is empty. Nothing is written if any step fails. Requires an existing PRD (run /specs/generate first).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestSpecChangeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied (or nothing to apply)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SpecChangeResult" }
              }
            }
          },
          "400": {
            "description": "Invalid instruction",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": {
            "description": "Project not found, or no PRD generated yet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "502": {
            "description": "The model provider failed, or its output failed validation after retries",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}/specs/{specId}/approve": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        },
        {
          "name": "specId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "post": {
        "tags": ["Specs"],
