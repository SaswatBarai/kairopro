# ─── KairoPro ────────────────────────────────────────────────────────────────
# Single root .env. Both apps/web and packages/db load this file explicitly.
# Never add a second .env inside a package.

# Database (KairoPro's own metadata store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kairopro"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                       # generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Credential encryption — AES-256-GCM key for stored third-party secrets.
# Generate: openssl rand -base64 32
# Rotating this value makes existing stored credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=""

# ─── Agent ───────────────────────────────────────────────────────────────────
# Primary provider is not yet chosen. Set the one you use.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ─── Execution ───────────────────────────────────────────────────────────────
# Where project workspaces and uploads live on disk
KAIROPRO_WORKSPACE_ROOT="/var/kairopro/workspaces"
KAIROPRO_UPLOAD_ROOT="/var/kairopro/uploads"

# Preview and deployment base domains
KAIROPRO_PREVIEW_DOMAIN="preview.kairopro.dev"
KAIROPRO_APP_DOMAIN="kairopro.app"

# ─── GitHub export ───────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="info"
